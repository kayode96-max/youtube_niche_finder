# ── SIGNAL v2 environment ──────────────────────────────────────────────
# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored — keys must NEVER be committed or shipped to the browser.

# YouTube Data API v3 key (Google Cloud Console → Credentials).
# Server-side only. The frontend never sees this.
YOUTUBE_API_KEY=

# Google Gemini API key (aistudio.google.com/apikey). Server-side only.
# The frontend never sees this.
GEMINI_API_KEY=

# Gemini model for the agent features. Defaults to a current, capable model.
GEMINI_MODEL=gemini-3.5-flash

# SQLite database file path (relative to /server, or absolute).
DATABASE_URL=./data/signal.sqlite

# Port the Express API listens on.
PORT=3000

# How long cached YouTube responses stay fresh, in hours.
CACHE_TTL_HOURS=6

# Per-session daily cap on AI agent calls (cost guardrail).
AGENT_DAILY_CAP=40
